# Supabase (optional — app falls back to SQLite if unset)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Keys (optional — users can supply their own via browser)
GEMINI_API_KEY=

# Stripe Billing (optional — required for Pro subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (optional — transactional emails via Resend)
RESEND_API_KEY=

# Analytics / Monitoring (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Scheduled Audits (optional — cron secret for /api/cron)
CRON_SECRET=

# Admin access (optional — comma-separated email addresses)
ADMIN_EMAILS=

# OAuth Providers (optional — required for Google/GitHub sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public base URL (optional — used for links in emails)
NEXT_PUBLIC_BASE_URL=
