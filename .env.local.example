# Supabase (optional for local demos; if unset, data uses process-local memory only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider Keys (required for scheduled/server-side audits)
GEMINI_API_KEY=

# Stripe Billing (required for Pro subscriptions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=

# Email (required for transactional emails via Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Analytics / Monitoring (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_DSN=

# Scheduled Audits (required when /api/cron or recurring audits are enabled)
CRON_SECRET=

# Admin access (AUTH_PASSWORD required if ADMIN_EMAILS is configured)
ADMIN_EMAILS=
AUTH_PASSWORD=

# Auth.js sessions (required in production)
NEXTAUTH_SECRET=

# OAuth Providers (optional — required for Google/GitHub sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public base URL (required for Stripe redirects and deployed email links)
NEXT_PUBLIC_BASE_URL=
